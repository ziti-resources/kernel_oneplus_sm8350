# AmpereKernel
CONFIG_LOCALVERSION="-Ampere-1.0"
CONFIG_LOCALVERSIO_AUTO=n

# Architectures
CONFIG_ARCH_YUPIK=y

# NFC
CONFIG_OPLUS_NFC=y
CONFIG_NFC_ST21_I2C=y

# Touchpanel
CONFIG_TOUCHPANEL_ILITEK=y
CONFIG_TOUCHPANEL_ILITEK_ILITEK7807S=y

# WiFi
CONFIG_CNSS_QCA6490=n
CONFIG_CNSS_QCA6750=y

